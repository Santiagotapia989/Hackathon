{
  "name": "aduana",
  "version": "0.1.0",
  "description": "Aduana — control de seguridad local para agentes de IA. Plataforma (API, ingesta, MCP, CLI).",
  "type": "module",
  "private": true,
  "bin": {
    "aduana": "./dist/plataforma/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "server": "tsx watch src/plataforma/server.ts",
    "server:stub": "cross-env ADUANA_MOTOR=stub tsx watch src/plataforma/server.ts",
    "mcp": "tsx src/plataforma/mcp.ts",
    "cli": "tsx src/plataforma/cli.ts",
    "db:reset": "tsx src/plataforma/scripts/db-reset.ts",
    "db:seed": "tsx src/plataforma/scripts/db-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.9.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "picocolors": "^1.1.1",
    "tar": "^7.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
